# No lyrical branches upstream. ros2_rust is pinned to the rclrs revision
# rmf_site_map_server builds against (its Cargo.toml git rev); the two
# rosidl repos to the main commits current at that revision.
repositories:
  # Rust client library for ROS 2 (provides the `rclrs` package)
  ros2-rust/ros2_rust:
    type: git
    url: https://github.com/ros2-rust/ros2_rust.git
    version: d27a8cb
  # Runtime support crate (provides the `rosidl_runtime_rs` package)
  ros2-rust/rosidl_runtime_rs:
    type: git
    url: https://github.com/ros2-rust/rosidl_runtime_rs.git
    version: 21def42
  # rosidl generator for Rust (provides the `rosidl_generator_rs` package).
  # Per upstream README: temporarily required until the next ROS 2 sync
  # ships an updated generator.
  ros2-rust/rosidl_rust:
    type: git
    url: https://github.com/ros2-rust/rosidl_rust.git
    version: 19d5781
