# Dockerfile.rmf-sim — derives from the shared rmf base.
#
# Gazebo + rmf_demos (fleet adapters, assets, launch files; NOT its
# traffic-editor maps) + rmf_simulation, with the example site from
# templates/site_sim/ as the default world. Worlds are generated from
# RMF Site Editor `.site.json` files; the editor is only used at build time,
# in the `worldgen` stage. Dockerfile.rmf-sim-site adds it to the image.
ARG ROS_DISTRO=lyrical
ARG RMF_IMAGE=open-rmf:${ROS_DISTRO}-rmf

# -----------------------------------------------------------------------
# rmf_site_editor builder. Keep in sync with Dockerfile.site-editor, which
# is the source of truth (pin and patch included).
# -----------------------------------------------------------------------
FROM ubuntu:resolute AS site-editor-builder

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl git pkg-config build-essential clang lld \
    libgtk-3-dev libasound2-dev libudev-dev \
    libx11-dev libxi-dev libxcursor-dev libxrandr-dev libxkbcommon-dev \
    libgl1-mesa-dev libxcb-cursor0 \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/opt/rustup \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:$PATH
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --default-toolchain stable --profile default

WORKDIR /opt/rmf_site
ARG RMF_SITE_REF=53504e0e067377904df250056eaf6595ca662e8e
COPY docker/patches/rmf_site_exporter_fixes.patch /tmp/
RUN git init --quiet . \
 && git fetch --quiet --depth 1 https://github.com/open-rmf/rmf_site.git ${RMF_SITE_REF} \
 && git checkout --quiet FETCH_HEAD \
 && git apply --verbose /tmp/rmf_site_exporter_fixes.patch \
 && cargo build --release --locked

# -----------------------------------------------------------------------
# sim packages
# -----------------------------------------------------------------------
FROM ${RMF_IMAGE} AS sim

LABEL org.opencontainers.image.title="open-rmf-sim" \
      org.opencontainers.image.description="Open-RMF simulation packages compiled from rmf-sim.repos" \
      org.opencontainers.image.vendor="Nexsoss" \
      org.opencontainers.image.source="https://github.com/nexsoss/Open-RMF" \
      org.opencontainers.image.documentation="https://github.com/nexsoss/Open-RMF" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.attribution="Open-RMF core packages (Apache-2.0) Copyright Open Robotics"

ARG ROS_DISTRO
ENV ROS_DISTRO=${ROS_DISTRO}
ENV DEBIAN_FRONTEND=noninteractive
ENV HOME=/home/ws_rmf

RUN apt-get update && apt-get install -y --no-install-recommends \
    qtbase5-dev \
    mesa-utils libgl1 libglx-mesa0 libgl1-mesa-dri \
    libxcb-cursor0 libxcb-xinerama0 \
    libglu1-mesa-dev \
    libx11-xcb-dev \
    ros-${ROS_DISTRO}-ros-gz \
    ros-${ROS_DISTRO}-ros-gz-sim \
    ros-${ROS_DISTRO}-ros-gz-bridge \
    && pip3 install --break-system-packages flask-socketio \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /home/ws_rmf
COPY ./repos/rmf-sim.repos rmf-sim.repos
# rmf_demos_maps is removed: its worlds are generated by the traffic editor,
# which these images do not use.
RUN mkdir -p src_sim && vcs import src_sim < rmf-sim.repos \
 && rm -rf src_sim/demonstrations/rmf_demos/rmf_demos_maps

RUN apt-get update && rosdep update && \
    rosdep install --from-paths src src_sim --ignore-src --rosdistro ${ROS_DISTRO} -y \
    --skip-keys "gz-ionic python3-paho-mqtt rmf_demos_maps rmf_building_map_tools rmf_site_editor rmf_site_cmake" \
    && rm -rf /var/lib/apt/lists/*

# Only the sim sources are built, on top of the RMF core already installed
# in the base. rmf_site_demos needs the editor, so it is built in
# Dockerfile.rmf-sim-site.
RUN /bin/bash -c "source /home/ws_rmf/install/setup.bash && \
    colcon build --base-paths src_sim \
        --packages-skip rmf_site_demos \
        --cmake-args -DCMAKE_BUILD_TYPE=Release"

# -----------------------------------------------------------------------
# worldgen: generate the default site's world and nav graphs with the
# editor, without shipping the editor in this image.
# -----------------------------------------------------------------------
FROM sim AS worldgen

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgtk-3-0 libasound2t64 libudev1 \
    libx11-6 libxi6 libxcursor1 libxrandr2 \
    libxkbcommon0 libxkbcommon-x11-0 \
    libgl1 libxcb-cursor0 \
    libvulkan1 mesa-vulkan-drivers libgl1-mesa-dri \
    && rm -rf /var/lib/apt/lists/*
COPY --from=site-editor-builder /opt/rmf_site/target/release/rmf_site_editor /usr/local/bin/rmf_site_editor
ENV WGPU_BACKEND=vulkan
ENV XDG_RUNTIME_DIR=/tmp/xdg-runtime
RUN mkdir -p /tmp/xdg-runtime && chmod 700 /tmp/xdg-runtime

COPY templates/site_sim/example_site src_sites/example_site
RUN /bin/bash -c "source /home/ws_rmf/install/setup.bash && \
    colcon build --base-paths src_sites --packages-select example_site"

# The editor exits 0 even when an export fails, leaving an empty world.
RUN /bin/bash -c 'set -eo pipefail; \
    for w in /home/ws_rmf/install/example_site/share/example_site/maps/*/*.world; do \
      test -s "$w" || { echo "FATAL: empty world $w"; exit 1; }; \
      ls "$(dirname "$w")"/nav_graphs/*.nav.yaml >/dev/null; \
    done'

# -----------------------------------------------------------------------
# final sim image
# -----------------------------------------------------------------------
FROM sim

COPY --from=worldgen /home/ws_rmf/install/example_site /home/ws_rmf/install/example_site
COPY templates/site_sim/example_site /home/ws_rmf/src_sites/example_site

ENV RMW_IMPLEMENTATION=rmw_zenoh_cpp
ENTRYPOINT ["/ros_entrypoint.sh"]
CMD ["bash"]
