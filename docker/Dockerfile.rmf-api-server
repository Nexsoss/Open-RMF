# Dockerfile.rmf-api-server — derives from the shared rmf base.
ARG ROS_DISTRO=lyrical
ARG RMF_IMAGE=open-rmf:${ROS_DISTRO}-rmf
FROM ${RMF_IMAGE}

LABEL org.opencontainers.image.title="open-rmf-api-server" \
      org.opencontainers.image.description="Open-RMF API server packages" \
      org.opencontainers.image.vendor="Nexsoss" \
      org.opencontainers.image.source="https://github.com/nexsoss/Open-RMF" \
      org.opencontainers.image.documentation="https://github.com/nexsoss/Open-RMF" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.base.name="docker.io/library/ros:lyrical-ros-base" \
      org.opencontainers.image.attribution="Open-RMF core packages (Apache-2.0) Copyright Open Robotics"

ARG ROS_DISTRO
ENV ROS_DISTRO=${ROS_DISTRO}
ENV DEBIAN_FRONTEND=noninteractive
ENV RMW_IMPLEMENTATION=rmw_zenoh_cpp
ENV HOME=/root

RUN apt-get update && apt-get install -y --no-install-recommends \
    git python3-pip python3-venv \
    netcat-openbsd \
    ros-${ROS_DISTRO}-rmf-fleet-msgs \
    ros-${ROS_DISTRO}-rmf-building-map-msgs \
    ros-${ROS_DISTRO}-rmf-door-msgs \
    ros-${ROS_DISTRO}-rmf-lift-msgs \
    ros-${ROS_DISTRO}-rmf-dispenser-msgs \
    ros-${ROS_DISTRO}-rmf-ingestor-msgs \
    ros-${ROS_DISTRO}-rmf-task-msgs \
    ros-${ROS_DISTRO}-rmf-charger-msgs \
    ros-${ROS_DISTRO}-rmf-reservation-msgs \
    ros-${ROS_DISTRO}-rmf-site-map-msgs \
    && rm -rf /var/lib/apt/lists/*

# The api-server's Python dependencies go in a venv that can still see the
# system site-packages (rclpy, ROS messages). Installing them into the system
# Python instead fails whenever one needs a newer version of a package Debian
# installed (packaging, typing_extensions, ...), which pip cannot replace.
RUN python3 -m venv --system-site-packages /opt/rmf/venv
ENV PATH=/opt/rmf/venv/bin:$PATH
RUN pip install --no-cache-dir pipenv==2026.6.2

WORKDIR /opt/rmf/src/rmf-web
# rmf-web `lyrical` branch head.
ARG RMF_WEB_REF=de892c7
RUN git clone https://github.com/open-rmf/rmf-web.git . \
 && git checkout --quiet ${RMF_WEB_REF}

RUN pipenv requirements > /tmp/requirements.txt
# Let pip resolve pydantic/asyncpg against this image's Python rather than
# taking the lockfile's exact versions.
RUN grep -v -iE "^(asyncpg|pydantic-core|pydantic)" /tmp/requirements.txt > /tmp/requirements-filtered.txt
RUN pip install --no-cache-dir -r /tmp/requirements-filtered.txt

RUN pip install --no-cache-dir -e "./packages/api-server[postgres]"

RUN pip list 2>/dev/null | grep -i uvicorn || echo "uvicorn NOT in pip3 list"
RUN python3 -c "import uvicorn; print('uvicorn OK:', uvicorn.__file__)"

WORKDIR /opt/rmf/src/rmf-web/packages/api-server
EXPOSE 8000
ENTRYPOINT ["/bin/bash", "-c"]

CMD ["source /home/ws_rmf/install/setup.bash && source /opt/ros/${ROS_DISTRO}/setup.bash && python3 -m api_server"]