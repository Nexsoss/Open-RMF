# Dockerfile.rmf-api-server — derives from the shared rmf base.
ARG ROS_DISTRO=lyrical
ARG RMF_IMAGE=open-rmf:${ROS_DISTRO}-rmf
FROM ${RMF_IMAGE}

ARG ROS_DISTRO
ENV ROS_DISTRO=${ROS_DISTRO}
ENV DEBIAN_FRONTEND=noninteractive
ENV RMW_IMPLEMENTATION=rmw_zenoh_cpp
ENV HOME=/root

RUN apt-get update && apt-get install -y --no-install-recommends \
    git python3-pip \
    ros-${ROS_DISTRO}-rmf-fleet-msgs \
    ros-${ROS_DISTRO}-rmf-building-map-msgs \
    ros-${ROS_DISTRO}-rmf-door-msgs \
    ros-${ROS_DISTRO}-rmf-lift-msgs \
    ros-${ROS_DISTRO}-rmf-dispenser-msgs \
    ros-${ROS_DISTRO}-rmf-ingestor-msgs \
    ros-${ROS_DISTRO}-rmf-task-msgs \
    ros-${ROS_DISTRO}-rmf-charger-msgs \
    ros-${ROS_DISTRO}-rmf-reservation-msgs \
    ros-${ROS_DISTRO}-rmf-site-map-msgs \
    && pip3 install --break-system-packages pipenv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/rmf/src/rmf-web
RUN git clone --single-branch --branch main --depth 1 \
    https://github.com/open-rmf/rmf-web.git .

RUN pipenv requirements > /tmp/requirements.txt
RUN grep -v -iE "^(asyncpg|pydantic-core|pydantic)" /tmp/requirements.txt > /tmp/requirements-filtered.txt
RUN pip3 install --break-system-packages -r /tmp/requirements-filtered.txt

# temp hacks to relax pydantic and asyncpg pins in api-server
RUN find packages/api-server -maxdepth 1 \( -name "pyproject.toml" -o -name "setup.py" -o -name "setup.cfg" \) | xargs grep -l "pydantic\|asyncpg" \
    | xargs -r sed -i -E \
        -e 's/pydantic~=2\.8\.0/pydantic>=2.8.0/g' \
        -e 's/(pydantic\[[a-z]*\])~=2\.8\.0/\1>=2.8.0/g' \
        -e 's/asyncpg~=0\.29\.0/asyncpg>=0.29.0/g'

RUN grep -rE "pydantic~=|asyncpg~=" packages/api-server/pyproject.toml packages/api-server/setup.py packages/api-server/setup.cfg 2>/dev/null || echo "all pins relaxed successfully"

RUN pip3 install --break-system-packages -e "./packages/api-server[postgres]"

RUN pip3 list 2>/dev/null | grep -i uvicorn || echo "uvicorn NOT in pip3 list"
RUN python3 -c "import uvicorn; print('uvicorn OK:', uvicorn.__file__)"

WORKDIR /opt/rmf/src/rmf-web/packages/api-server
EXPOSE 8000
ENTRYPOINT ["/bin/bash", "-c"]

# Source the base's install space before /opt/ros so the source-built msgs win.
CMD ["source /home/ws_rmf/install/setup.bash && source /opt/ros/${ROS_DISTRO}/setup.bash && python3 -m api_server"]